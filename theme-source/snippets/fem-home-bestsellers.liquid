              {% assign card_classes = 'fem-bestsellers__slider-slide-6,fem-bestsellers__layout-2,fem-bestsellers__layout-3,fem-bestsellers__span-11,fem-bestsellers__text-8,fem-bestsellers__media,fem-bestsellers__product-title,fem-bestsellers__layout-4,fem-bestsellers__price-6,fem-bestsellers__span-12,fem-bestsellers__layout-5,fem-bestsellers__link,fem-bestsellers__text-2,fem-bestsellers__icon' | split: ',' %}
