              {% assign card_classes = 'fem-bestsellers__slider-slide-7,fem-bestsellers__layout-2,fem-bestsellers__layout-3,fem-bestsellers__span-13,fem-bestsellers__text-9,fem-bestsellers__media,fem-bestsellers__product-title,fem-bestsellers__layout-4,fem-bestsellers__price-7,fem-bestsellers__span-14,fem-bestsellers__layout-5,fem-bestsellers__link,fem-bestsellers__text-2,fem-bestsellers__icon' | split: ',' %}
{% render 'fem-product-card', card_product: all_products['combo-fem-x-ovulos'], card_classes: card_classes, cta_text: 'Ver producto', section: section %}
              {% assign card_classes = 'fem-bestsellers__slider-slide-8,fem-bestsellers__layout-2,fem-bestsellers__layout-3,fem-bestsellers__span-15,fem-bestsellers__text-10,fem-bestsellers__media,fem-bestsellers__product-title,fem-bestsellers__layout-4,fem-bestsellers__price-8,fem-bestsellers__span-16,fem-bestsellers__layout-5,fem-bestsellers__link,fem-bestsellers__text-2,fem-bestsellers__icon' | split: ',' %}
{% render 'fem-product-card', card_product: all_products['combo-dia-de-la-mujer'], card_classes: card_classes, cta_text: 'Ver producto', section: section %}
</div>
</div>
