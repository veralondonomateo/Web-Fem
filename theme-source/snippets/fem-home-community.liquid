{% doc %}
  Renders the Fem community video carousel with Instagram links and native controls.
  @param {section} section - The home section containing the shared icon definitions.
{% enddoc %}
<section class="fem-community__section" id="fem-community__section" aria-labelledby="fem-community-title-{{ section.id }}">
<div class="fem-community__layout">
<div class="fem-community__layout-2">
<div class="fem-copy fem-community__heading">
<h2 id="fem-community-title-{{ section.id }}">Comunidad <em>Fem</em></h2>
</div>
<p class="fem-community__description">Encuentros, historias y momentos para compartir.</p>
</div>
<div class="fem-community__layout-3">
<div class="fem-carousel fem-community__slider-container" data-fem-carousel="{&quot;breakpoints&quot;:{&quot;0&quot;:{&quot;view&quot;:1.3,&quot;gap&quot;:14},&quot;576&quot;:{&quot;view&quot;:2.4,&quot;gap&quot;:18},&quot;769&quot;:{&quot;view&quot;:3,&quot;gap&quot;:18},&quot;1025&quot;:{&quot;view&quot;:4,&quot;gap&quot;:18},&quot;1280&quot;:{&quot;view&quot;:5,&quot;gap&quot;:18}},&quot;speed&quot;:500,&quot;loop&quot;:true}">
