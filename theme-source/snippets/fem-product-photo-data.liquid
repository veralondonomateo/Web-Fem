      assign photos = 'fem-fem-mom-gallery-1.webp|1761|1761,fem-fem-mom-gallery-2.webp|619|619,fem-fem-mom-gallery-3.webp|619|619,fem-fem-mom-gallery-4.webp|619|619,fem-fem-mom-gallery-5.webp|619|619,fem-fem-mom-gallery-6.webp|619|619' | split: ','
