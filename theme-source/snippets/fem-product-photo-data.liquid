{% doc %}
Generated product photo lookup, kept in sync with the supplied galleries.
@param {product} card_product - Product whose photo is requested.
@param {string} [product_handle] - Explicit product handle.
@param {number} [photo_index] - Photo position, starting at 1.
{% enddoc %}
{%- liquid
  assign photos = blank
  assign handle = product_handle | default: card_product.handle
  if handle == blank
    assign handle = card_product.url | split: '/products/' | last | split: '?' | first | split: '#' | first
  endif
  case handle
    when 'jabon-intimo-ph-neutro'
      assign photos = 'fem-jabon-gallery-1.webp|1641|1642,fem-jabon-gallery-2.webp|619|619,fem-jabon-gallery-3.webp|619|619,fem-jabon-gallery-4.webp|619|619,fem-jabon-gallery-5.webp|619|619' | split: ','
    when 'probiotico-vaginal-en-capsulas-x100-unidades'
      assign photos = 'fem-probioticos-gallery-1.webp|2000|2000,fem-probioticos-gallery-2.webp|599|599,fem-probioticos-gallery-3.webp|599|599,fem-probioticos-gallery-4.webp|599|599,fem-probioticos-gallery-5.webp|599|599,fem-probioticos-gallery-6.webp|599|599' | split: ','
    when 'gomitas-sindrome-premestrual-x60'
      assign photos = 'fem-gomas-gallery-1.webp|1688|1688,fem-gomas-gallery-2.webp|619|619,fem-gomas-gallery-3.webp|619|619,fem-gomas-gallery-4.webp|619|619,fem-gomas-gallery-5.webp|619|619' | split: ','
    when 'ovulos-vaginales-fem'
