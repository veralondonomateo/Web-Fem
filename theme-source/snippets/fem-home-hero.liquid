{% doc %}
  Renders the Fem homepage introduction and its product image.
  @param {section} section - Homepage section with editable copy and links.
  @example
  {% render 'fem-home-hero', section: section %}
{% enddoc %}
{{ 'fem-home-hero.css' | asset_url | stylesheet_tag }}
<section class="fem-home-hero" aria-labelledby="fem-home-title-{{ section.id }}" style="--hero-background:{{ section.settings.hero_background }}; --hero-accent:{{ section.settings.hero_accent }};">
  <div class="fem-home-hero__inner">
    <div class="fem-home-hero__copy">
      <h1 class="fem-home-hero__title" id="fem-home-title-{{ section.id }}">{{ section.settings.hero_heading | escape }}</h1>
      <p class="fem-home-hero__description">{{ section.settings.hero_description | escape }}</p>
      <div class="fem-home-hero__actions">
        <a class="fem-home-hero__button" href="{{ section.settings.hero_shop_link | escape }}">{{ section.settings.hero_shop_label | escape }}{% render 'fem-home-hero-icon', icon: 'arrow' %}</a>
        <a class="fem-home-hero__button fem-home-hero__button--secondary" href="{{ section.settings.hero_quiz_link | escape }}">{{ section.settings.hero_quiz_label | escape }}{% render 'fem-home-hero-icon', icon: 'arrow' %}</a>
      </div>
      <ul class="fem-home-hero__guarantees" role="list">
        <li>{% render 'fem-home-hero-icon', icon: 'check' %}{{ section.settings.hero_shipping | escape }}</li>
        <li>{% render 'fem-home-hero-icon', icon: 'check' %}{{ section.settings.hero_guarantee | escape }}</li>
      </ul>
    </div>
    <div class="fem-home-hero__media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 660 | image_tag: class: 'fem-home-hero__image', widths: '260, 440, 660', sizes: '(max-width: 749px) 180px, 220px', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
      {% else %}
        <img class="fem-home-hero__image" src="{{ 'fem-home-probiotics.webp' | asset_url }}" width="662" height="969" alt="{{ section.settings.hero_image_alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
      {% endif %}
    </div>
  </div>
</section>
