{% doc %}
  Renders real collaborator profiles only when name, credentials and source are supplied.
  @param {section} section - Homepage section with optional expert blocks.
{% enddoc %}
{%- capture expert_profiles -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'expert' and block.settings.name != blank and block.settings.credentials != blank and block.settings.source_url != blank -%}
      <article class="fem-home-specialist" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.name | escape }}</h3>
        <p class="fem-home-specialist__credentials">{{ block.settings.credentials | escape }}</p>
        {% if block.settings.affiliation != blank %}<p>{{ block.settings.affiliation | escape }}</p>{% endif %}
        {% if block.settings.contribution != blank %}<p>{{ block.settings.contribution | escape }}</p>{% endif %}
        <a href="{{ block.settings.source_url | escape }}" target="_blank" rel="noopener noreferrer">Ver perfil o publicación <span class="fem-home-sources__new-tab">(abre otra pestaña)</span></a>
      </article>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{% if expert_profiles != blank %}
  <section class="fem-home-specialists" aria-labelledby="fem-home-specialists-title-{{ section.id }}">
    <div class="fem-home-sources__inner">
      <header class="fem-home-sources__intro">
        <h2 id="fem-home-specialists-title-{{ section.id }}">Profesionales que colaboran con FEM</h2>
      </header>
      <div class="fem-home-specialists__grid">{{ expert_profiles }}</div>
    </div>
  </section>
{% endif %}
