{% doc %}
Displays the existing transparent photograph in a viewport matching the old banner image.
The view box excludes empty transparent margins without modifying the photo pixels.
@param {string} photo_asset - Transparent product asset.
@param {number} photo_width - Original photo width.
@param {number} photo_height - Original photo height.
@param {string} view_box - Product bounds within the photo.
@param {number} display_width - Previous banner image width.
@param {number} display_height - Previous banner image height.
@param {string} image_class - Original responsive image classes.
@param {string} [image_alt] - Product description.
{% enddoc %}
{%- capture preview_asset -%}{% render 'fem-cutout-preview-asset', photo_asset: photo_asset %}{%- endcapture -%}
{%- liquid
  assign photo_filter = 'saturate(.85)'
  if photo_asset == 'fem-probioticos-why-transparent-v1.webp'
    assign photo_filter = 'saturate(.75) contrast(.9) brightness(1.11) hue-rotate(5deg)'
  endif
-%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ display_width }}" height="{{ display_height }}" viewBox="{{ view_box | escape }}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{ image_alt | default: 'Producto Fem' | escape }}" class="{{ image_class | escape }}" style="width:100%;height:auto;aspect-ratio:{{ display_width }}/{{ display_height }};filter:{{ photo_filter }}" data-fem-sticky-product-photo>
  <image href="{{ preview_asset | asset_url }}" width="{{ photo_width }}" height="{{ photo_height }}" />
</svg>
