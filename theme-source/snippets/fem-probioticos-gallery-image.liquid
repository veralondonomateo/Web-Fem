{% doc %}
  Render one of the six supplied probiotic product photographs in filename order.
  @param {number} index - Photo position from 1 through 6.
  @param {string} repeater_id - Gallery image identifier.
  @param {number} repeater_index - Zero-based photo position.
  @param {string} image_role - Main, thumbnail, or zoom image.
{% enddoc %}
{%- liquid
  assign image_size = 599
  case index
    when 1
      assign image_size = 2000
      assign image_alt = 'Alimento con probióticos y prebióticos — presentación del producto'
    when 2
      assign image_alt = 'Alimento con probióticos y prebióticos — información del producto'
    when 3
      assign image_alt = 'Alimento con probióticos y prebióticos — tabletas masticables'
    when 4
      assign image_alt = 'Alimento con probióticos y prebióticos — ingredientes y conservación'
    when 5
      assign image_alt = 'Alimento con probióticos y prebióticos — comparación con otras marcas'
    when 6
      assign image_alt = 'Alimento con probióticos y prebióticos — reseñas de clientas'
  endcase
  assign image_asset = 'fem-probioticos-gallery-' | append: index | append: '.webp'
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if image_role == 'thumbnail'
    assign image_loading = 'eager'
  elsif image_role == 'main' and index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}
<img src="{{ image_asset | asset_url }}" alt="{{ image_alt | escape }}" width="{{ image_size }}" height="{{ image_size }}" loading="{{ image_loading }}" fetchpriority="{{ image_priority }}" decoding="async" class="fem-view-media fem-view-image fem-view-image__main" data-fem-dynamic-content-source="REPEATER" data-fem-repeater-id="{{ repeater_id }}" data-fem-repeater-index="{{ repeater_index }}" {% if image_role == 'zoom' %}style="object-fit:contain"{% endif %}>
