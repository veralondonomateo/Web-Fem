{% doc %}
Product card with live Shopify prices, sale badge and responsive image.
@param {product} card_product
@param {string[]} card_classes
@param {string} cta_text
@param {section} section
{% enddoc %}
{%- liquid
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_image = card_variant.featured_image | default: card_product.featured_image
-%}
<article class="fem-carousel__slide {{ card_classes[0] }}">
<div class="{{ card_classes[1] }}">
                  {%- liquid
                    assign style = ''
                    assign is_on_sale = false
                    if card_variant.compare_at_price and card_variant.compare_at_price > card_variant.price
                      assign is_on_sale = true
                    endif
                    if is_on_sale != true
                      assign style = 'style="display: none;"'
                    endif
                  -%}
                  <div class="{{ card_classes[2] }}" {{- style -}}>
                    {%- liquid
                      assign style = ''
                      assign compare_at_price = card_variant.compare_at_price
                      assign variant_price = card_variant.price
                      if card_variant.selected_selling_plan_allocation
                        assign compare_at_price = card_variant.selected_selling_plan_allocation.compare_at_price
                        assign variant_price = card_variant.selected_selling_plan_allocation.price
                      endif
                      assign saved_amount = compare_at_price | minus: variant_price | times: 100 | divided_by: compare_at_price | floor
                      if compare_at_price <= variant_price or saved_amount <= 0 or compare_at_price == null
                        assign style = 'style="display: none;"'
                      endif
                    -%}
                    <span class="{{ card_classes[3] }}" {{- style -}}>
                      {{- saved_amount -}}
                      %
                    </span>
<div class="fem-copy {{ card_classes[4] }}">
<p>OFF</p>
</div>
</div>
<a class="{{ card_classes[5] }}" href="{{ card_product.url }}" rel="noopener noreferrer">
{%- capture fem_image_fallback -%}<img alt="{{ card_image.alt }}" src="{{ card_image | image_url: width: 1280 }}" sizes="(max-width: 600px) 72vw, (max-width: 1024px) 38vw, 300px" srcset="{{ card_image | image_url: width: 1080 }} 1080w, {{ card_image | image_url: width: 828 }} 828w, {{ card_image | image_url: width: 750 }} 750w, {{ card_image | image_url: width: 640 }} 640w, {{ card_image | image_url: width: 360 }} 360w, {{ card_image | image_url: width: 1280 }} 1280w" class="fem-media fem-image fem-image__main" width="{{ card_image.width }}" height="{{ card_image.height }}" loading="lazy" fetchpriority="low" decoding="async">{%- endcapture -%}
{%- capture fem_image_class -%}fem-media fem-image fem-image__main{%- endcapture -%}
{%- capture fem_image_attributes -%}{%- endcapture -%}
{% render 'fem-product-image', card_product: card_product, photo_index: 1, fallback: fem_image_fallback, image_class: fem_image_class, image_attributes: fem_image_attributes, loading: 'lazy', fetchpriority: 'low', decorative: false %}
</a>
</div>
<p class="{{ card_classes[6] }}">{{ card_product.title }}</p>
<div class="{{ card_classes[7] }}">
<p class="{{ card_classes[8] }}">
                    {%- liquid
                      assign variant_price = card_variant.price
                      if card_variant.selected_selling_plan_allocation
                        assign variant_price = card_variant.selected_selling_plan_allocation.price
                      endif
                    -%}
                    {{- variant_price | money -}}
                  </p>
                  {%- liquid
                    assign style = ''
                    assign compare_at_price = card_variant.compare_at_price
                    assign variant_price = card_variant.price
                    if card_variant.selected_selling_plan_allocation
                      assign compare_at_price = card_variant.selected_selling_plan_allocation.compare_at_price
                      assign variant_price = card_variant.selected_selling_plan_allocation.price
                    endif
                    if compare_at_price <= variant_price or compare_at_price == 0 or compare_at_price == null
                      assign style = 'style="display: none;"'
                    endif
                  -%}
                  <span class="{{ card_classes[9] }}" {{- style -}}>
                    {{- compare_at_price | money -}}
                  </span>
</div>
<div class="{{ card_classes[10] }}">
</div>
<a class="{{ card_classes[11] }}" href="{{ card_product.url }}" rel="noopener noreferrer">
<div class="fem-copy {{ card_classes[12] }}">
<p>{{ cta_text }}</p>
</div>
<div class="{{ card_classes[13] }}">
<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="fem-icon">
<title>shopping-cart</title>
<use href="#fem-home-icon-{{ section.id }}-3">
</use>
</svg>
</div>
</a>
</article>
