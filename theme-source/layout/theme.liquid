<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
<meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      (function() {
        const SESSION_KEY = 'user_geo_city';
        const urlParams = new URLSearchParams(window.location.search);
        const paramCity = urlParams.get('city');

        if (paramCity) {
          const normalized = paramCity.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
          window.customerCity = normalized;
          sessionStorage.setItem(SESSION_KEY, normalized);
          return;
        }

        const city = sessionStorage.getItem(SESSION_KEY);

        if (city) {
          window.customerCity = city;
        } else {
          fetch('https://get.geojs.io/v1/ip/geo.json')
            .then(function(response) {
              return response.json();
            })
            .then(function(data) {
              const detectedCity = data.city
                ? data.city.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                : '';

              window.customerCity = detectedCity;
              sessionStorage.setItem(SESSION_KEY, detectedCity);
            })
            .catch(function(err) {
              console.error('Error geo:', err);
            });
        }
      })();
    </script>

    {%- render 'stylesheets' -%}
    {{ 'fem-typography.css' | asset_url | stylesheet_tag }}
    {{ 'fem-section-headings.css' | asset_url | stylesheet_tag }}
    {% if template.name == 'product' %}
      {{ 'fem-product-accordions.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <!-- Event snippet for Google Shopping App Purchase conversion page -->
      <script>
        gtag('event', 'conversion', {
            'send_to': 'AW-16944860206/PSfGCKORlbwaEK6Y-I8_',
            'value': 1.0,
            'currency': 'COP',
            'transaction_id': ''
        });
      </script>

       <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-PRZLP6VT');</script>
        <!-- End Google Tag Manager -->

  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {% if shop.refund_policy != blank and request.path == shop.refund_policy.url %}
        {% render 'fem-refund-policy', policy: shop.refund_policy %}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% if template.name == 'index' %}
      {% section 'fem-footer' %}
    {% else %}
      {% sections 'footer-group' %}
    {% endif %}

    {% section 'fem-cart-drawer' %}
    {% render 'fem-scratch-card' %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  {% render 'revie-reviews' %}

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PRZLP6VT"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

</body>
</html>

