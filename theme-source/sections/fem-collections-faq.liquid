<section class="fem-collections-faq" aria-labelledby="collections-faq-{{ section.id }}">
  <div class="fem-collections-inner fem-collections-faq-layout">
    <header>
      {% assign faq_heading_words = section.settings.heading | split: ' ' %}
      <h2 id="collections-faq-{{ section.id }}">{% for word in faq_heading_words %}{% unless forloop.first %} {% endunless %}{% if forloop.last %}<em>{{ word | escape }}</em>{% else %}{{ word | escape }}{% endif %}{% endfor %}</h2>
      <h3>{{ section.settings.subheading | escape }}</h3>
      <p>{{ section.settings.description | escape }}</p>
      {% if section.settings.contact_url != blank %}<a class="fem-collections-contact" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </header>
    <div class="fem-collections-questions">
      {% for block in section.blocks %}
        <details class="fem-collections-question" name="collections-faq-{{ section.id }}" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary>
          <div class="fem-collections-answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Preguntas de colecciones",
  "max_blocks":12,
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Preguntas frecuentes"},
    {"type":"text","id":"subheading","label":"Subtítulo","default":"¿Tienes dudas?"},
    {"type":"text","id":"description","label":"Descripción","default":"Estamos aquí para asesorarte"},
    {"type":"text","id":"contact_label","label":"Texto del botón","default":"Contáctanos"},
    {"type":"url","id":"contact_url","label":"Enlace de contacto","default":"/pages/contact"},
    {"type":"checkbox","id":"open_first","label":"Abrir la primera pregunta","default":true}
  ],
  "blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta"},{"type":"richtext","id":"answer","label":"Respuesta"}]}],
  "presets":[{"name":"Preguntas de colecciones"}]
}
{% endschema %}
