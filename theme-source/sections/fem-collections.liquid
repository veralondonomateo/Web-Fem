{{ 'fem-collections.css' | asset_url | stylesheet_tag }}
<section class="fem-collections-page{% if section.settings.embedded %} fem-collections-page--embedded{% endif %}" aria-labelledby="collections-title-{{ section.id }}">
  <header class="fem-collections-hero">
    <div class="fem-collections-inner">
      {% if section.settings.embedded %}
        <h2 id="collections-title-{{ section.id }}" class="fem-collections-heading">{{ section.settings.heading | escape }}</h2>
      {% else %}
        <h1 id="collections-title-{{ section.id }}" class="fem-collections-heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}<p class="fem-collections-description">{{ section.settings.description | escape }}</p>{% endif %}
      {% unless section.settings.embedded %}
        <nav class="fem-collections-breadcrumb" aria-label="Ruta de navegación"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">{{ section.settings.heading | escape }}</span></nav>
      {% endunless %}
    </div>
  </header>
  <div class="fem-collections-catalog">
    <div class="fem-collections-inner fem-collections-grid">
      {% for block in section.blocks %}
        {% liquid
          assign target = block.settings.collection
          assign destination = target.url | default: block.settings.link | default: routes.all_products_collection_url
          assign title = block.settings.title | default: target.title
          assign artwork = block.settings.artwork | default: 'all'
          assign photo_asset = 'fem-collection-' | append: artwork | append: '.webp'
          assign photo_width = 600
          assign photo_height = 910
          if artwork == 'all'
            assign photo_height = 899
          endif
        %}
        <a class="fem-collection-card" href="{{ destination | escape }}" aria-labelledby="collection-card-title-{{ section.id }}-{{ block.id | default: forloop.index }}" {{ block.shopify_attributes }}>
          <div class="fem-collection-card-visual">
          {% if block.settings.image != blank %}
            <img class="fem-collection-card-photo" src="{{ block.settings.image | image_url: width: 1000 }}" alt="" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" decoding="async">
          {% else %}
            <img class="fem-collection-card-photo" src="{{ photo_asset | asset_url }}" alt="" width="{{ photo_width }}" height="{{ photo_height }}" loading="lazy" decoding="async">
          {% endif %}
          <img class="fem-collection-card-logo" src="{{ 'fem-logo-fem-web-a760cdd1.svg' | asset_url }}" alt="" width="565" height="177" loading="lazy">
          </div>
          <h2 id="collection-card-title-{{ section.id }}-{{ block.id | default: forloop.index }}" class="fem-collection-card-title">{{ title | escape }}</h2>
          <span class="fem-collection-card-cta" aria-hidden="true">
            <span>{{ 'fem_collections.view_collection' | t }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Colecciones",
  "max_blocks":8,
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Colecciones"},
    {"type":"textarea","id":"description","label":"Descripción","default":"Soluciones pensadas para cada etapa de tu cuidado íntimo. Elige lo que tu cuerpo necesita hoy."},
    {"type":"checkbox","id":"embedded","label":"Mostrar dentro de otra página","default":false}
  ],
  "blocks":[{"type":"collection","name":"Colección","settings":[
    {"type":"collection","id":"collection","label":"Colección"},
    {"type":"text","id":"title","label":"Título de la tarjeta"},
    {"type":"url","id":"link","label":"Enlace alternativo"},
    {"type":"select","id":"artwork","label":"Fotografía Fem","default":"all","options":[{"value":"combos","label":"Combos"},{"value":"bestsellers","label":"Más vendidos"},{"value":"promotions","label":"Promociones"},{"value":"all","label":"Todos los productos"}]},
    {"type":"image_picker","id":"image","label":"Fotografía personalizada"}
  ]}],
  "presets":[{"name":"Colecciones","blocks":[{"type":"collection","settings":{"collection":"combo-fem","title":"Combos Fem","artwork":"combos"}},{"type":"collection","settings":{"collection":"mas-vendidos","title":"Más vendidos","artwork":"bestsellers"}},{"type":"collection","settings":{"collection":"frontpage","title":"Promos Fem","artwork":"promotions"}},{"type":"collection","settings":{"collection":"todos-los-productos","title":"Todos los productos","artwork":"all"}}]}]
}
{% endschema %}
