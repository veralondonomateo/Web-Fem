{{ 'fem-subscription-plans.css' | asset_url | stylesheet_tag }}
<section class="fem-plans" aria-labelledby="plans-title-{{ section.id }}">
  <header class="fem-plans__hero">
    <div class="fem-plans__inner">
      <h1 id="plans-title-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.description != blank %}<p class="fem-plans__description">{{ section.settings.description | escape }}</p>{% endif %}
      <nav class="fem-plans__breadcrumb" aria-label="{{ 'fem_plans.breadcrumb' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'fem_plans.home' | t }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ section.settings.heading | escape }}</span>
      </nav>
    </div>
  </header>
  <div class="fem-plans__catalog">
    <div class="fem-plans__inner">
      <div class="fem-plans__grid" aria-label="{{ 'fem_plans.options' | t | escape }}">
        {% assign plans = section.blocks | where: 'type', 'plan' %}
        {% for block in plans %}
          {% liquid
            assign artwork = block.settings.artwork | default: 'duo'
            assign image_asset = 'fem-duo-gallery-1.webp'
            assign image_width = 1254
            assign image_height = 1254
            case artwork
              when 'probiotics'
                assign image_asset = 'fem-probioticos-gallery-1.webp'
                assign image_width = 2000
                assign image_height = 2000
              when 'duo-double'
                assign image_asset = 'fem-collection-promotions.webp'
                assign image_width = 600
                assign image_height = 910
              when 'mom'
                assign image_asset = 'fem-fem-mom-gallery-1.webp'
                assign image_width = 1761
                assign image_height = 1761
            endcase
            assign benefits = block.settings.benefits | newline_to_br | split: '<br />'
          %}
          <article class="fem-plan{% if block.settings.palette == 'purple' %} fem-plan--purple{% endif %}" aria-labelledby="plan-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
            {% if block.settings.recommended %}<span class="fem-plan__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-13h-7z"/></svg>{{ 'fem_plans.recommended' | t }}</span>{% endif %}
            <header class="fem-plan__header">
              <h2 id="plan-{{ section.id }}-{{ block.id }}" class="fem-plan__name">{{ block.settings.title | escape }}</h2>
              <p class="fem-plan__price"><strong>{{ block.settings.price | escape }}</strong> <span class="fem-plan__price-period">{{ 'fem_plans.per_month' | t }}</span></p>
              <p class="fem-plan__contents"><span>{{ 'fem_plans.includes' | t }}</span> {{ block.settings.contents | escape }}</p>
            </header>
            <div class="fem-plan__body">
              {% if block.settings.image != blank %}
                <img class="fem-plan__image" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" decoding="async">
              {% else %}
                <img class="fem-plan__image{% if artwork == 'duo-double' %} fem-plan__image--duo-double{% endif %}" src="{{ image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" decoding="async">
              {% endif %}
              <ul class="fem-plan__features">
                {% for benefit in benefits %}
                  {% assign text = benefit | strip %}
                  {% if text != blank %}<li><span class="fem-plan__check" aria-hidden="true">✓</span><span>{{ text | escape }}</span></li>{% endif %}
                {% endfor %}
              </ul>
              <div class="fem-plan__purchase">
                {% if block.settings.link != blank %}
                  <a class="fem-plan__button" href="{{ block.settings.link | escape }}" aria-label="{{ 'fem_plans.start' | t | escape }}: {{ block.settings.title | escape }}">{{ 'fem_plans.start' | t }}<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% assign benefits = section.blocks | where: 'type', 'benefit' %}
      {% if benefits.size > 0 %}
        <div class="fem-plans__benefits" role="group" aria-label="{{ 'fem_plans.benefits' | t | escape }}">
          {% for block in benefits %}
            <details class="fem-plans__benefit" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <div class="fem-plans__answer">{{ block.settings.description }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Planes Fem",
  "max_blocks":16,
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Planes fem"},
    {"type":"textarea","id":"description","label":"Descripción","default":"Suscribirte es elegir cuidarte mes a mes, sin olvidos y con beneficios exclusivos pensados para ti."}
  ],
  "blocks":[
    {"type":"plan","name":"Plan mensual","settings":[
      {"type":"text","id":"title","label":"Nombre del plan","default":"Dúo Fem"},
      {"type":"text","id":"contents","label":"Productos incluidos","default":"1 probiótico + 1 jabón íntimo cada mes"},
      {"type":"textarea","id":"benefits","label":"Beneficios (uno por línea)"},
      {"type":"text","id":"price","label":"Precio con formato y moneda","default":"$114.900"},
      {"type":"url","id":"link","label":"Enlace para empezar el plan"},
      {"type":"checkbox","id":"recommended","label":"Destacar como recomendado","default":false},
      {"type":"select","id":"palette","label":"Color del plan","default":"rose","options":[{"value":"rose","label":"Rosado"},{"value":"purple","label":"Morado Fem Mom"}]},
      {"type":"select","id":"artwork","label":"Fotografía Fem","default":"duo","options":[{"value":"duo","label":"Probiótico y jabón"},{"value":"probiotics","label":"Probióticos"},{"value":"duo-double","label":"Dúo doble"},{"value":"mom","label":"Fem Mom"}]},
      {"type":"image_picker","id":"image","label":"Fotografía personalizada"}
    ]},
    {"type":"benefit","name":"Beneficio desplegable","settings":[
      {"type":"text","id":"title","label":"Título","default":"Ahorro exclusivo"},
      {"type":"richtext","id":"description","label":"Descripción","default":"<p>Accede a precios especiales solo para suscriptoras y cuida tu bienestar íntimo pagando menos.</p>"}
    ]}
  ],
  "presets":[{"name":"Planes Fem"}]
}
{% endschema %}
