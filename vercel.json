{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "store": {
      "buildCommand": "npm run vercel-build",
      "outputDirectory": "public",
      "functions": {
        "api/store.ts": {
          "maxDuration": 60,
          "includeFiles": "{audit/redirects.json,docs/review.html,server/*.json,theme-source/{snippets,sections,templates,locales,config}/**}"
        }
      },
      "root": ".",
      "entrypoint": "api/store.ts"
    },
    "gateway": {
      "root": "integrations",
      "functions": {
        "api/index.mjs": {
          "maxDuration": 60,
          "includeFiles": "../{admin,milestone}/**"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "store",
          "format": "url",
          "env": "STORE_INTERNAL_URL"
        },
        {
          "type": "service",
          "service": "checkout",
          "format": "url",
          "env": "CHECKOUT_INTERNAL_URL"
        },
        {
          "type": "service",
          "service": "crm",
          "format": "url",
          "env": "CRM_INTERNAL_URL"
        }
      ],
      "entrypoint": "api/index.mjs",
      "buildCommand": "node ../scripts/build-gateway.mjs"
    },
    "checkout": {
      "root": "apps/checkout",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    },
    "crm": {
      "root": "apps/crm",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/milestone-assets/equipo.jpg",
      "destination": {
        "service": "store"
      }
    },
    {
      "source": "/__theme/(.*)",
      "destination": {
        "service": "store"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "gateway"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
