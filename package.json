{
  "name": "fem-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-store.ts",
    "predev": "npm run build",
    "dev": "node --watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "pretest": "npm run build",
    "audit:links": "node scripts/check-links.ts",
    "assets:audit": "node scripts/prune-assets.ts",
    "dev:unified": "node scripts/unified.mjs",
    "test:unified": "node --test tests/unified.test.mjs",
    "vercel-build": "npm run build && node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "cheerio": "^1.2.0",
    "liquidjs": "^10.29.0"
  },
  "engines": {
    "node": "24.x"
  }
}
